n = int(input("Enter number of processes: "))

processes = []

for i in range(n):
    bt = int(input(f"Enter burst time for P{i+1}: "))
    priority = int(input(f"Enter priority for P{i+1}: "))
    processes.append([i+1, bt, priority])

# Sort processes by priority (smaller number = higher priority)
processes.sort(key=lambda x: x[2])

wt = 0
total_wt = 0
total_tat = 0

print("\nProcess\tBT\tPriority\tWT\tTAT")

for p in processes:
    pid, bt, priority = p
    tat = wt + bt

    print(f"P{pid}\t{bt}\t{priority}\t\t{wt}\t{tat}")

    total_wt += wt
    total_tat += tat
    wt += bt

print("\nAverage Waiting Time =", total_wt / n)
print("Average Turnaround Time =", total_tat / n)
